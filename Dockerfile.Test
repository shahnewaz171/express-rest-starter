FROM node:22-slim

LABEL org.opencontainers.image.authors="Muhammad Shahnewaz"

# pnpm setup (pinned for CI stability)
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

WORKDIR /app

# prevent husky / git hook failures in Docker
ENV HUSKY=0

# dependency layer (cached)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# source code
COPY . .

# build step (main CI check)
RUN pnpm build