FROM node:22-slim

LABEL org.opencontainers.image.authors="Muhammad Shahnewaz"

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# prevent husky / git hook failures in Docker
ENV HUSKY=0

# dependency layer (cached)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --ignore-scripts

# source layer
COPY . .

EXPOSE 8000

CMD ["pnpm", "dev"]
